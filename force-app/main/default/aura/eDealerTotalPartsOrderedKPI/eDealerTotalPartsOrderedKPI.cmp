<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" 
                controller="EDealerTotalPartsOrderedKPICtrl"
                extends="c:edealerTracking"  access="global" >
                
    
    <!-- this will save the title of the tile -->
    <aura:attribute name="title" type="string" />
    
    <!-- saving the selected options -->
    <aura:attribute name="selectedoption" type="string" default="All"/>
    
    <!-- dealer division -->
    <aura:attribute name="currentDealerDivision" type="string"/>
    
    <!-- saving the percentage -->
    <aura:attribute name="activeOrders" type="List" />
    
    <!-- this will save the measuring unit -->
    <aura:attribute name="units" type="string" />
    
    <!-- Selected Dealer Location/ code -->
    <aura:attribute name="dealerLoc" type="string"/>
    <aura:attribute name="listDealerLoc" type="LIST"/>
    
    <!-- Selected Order dropdown -->
    <aura:attribute name="selectedOrder" type="string" default="All"/>
    
    <!-- Selected Active Order dropdown -->
    <aura:attribute name="selectedActiveOrder" type="string" default="All"/>
    
    <!-- this will save the total order parts api details -->
    <aura:attribute name="totalPartsData" type="Object" />
    
    <!-- this will save the total parts api details cache -->
    <aura:attribute name="totalPartsDataMapCache" type="Map" />
    
    <!-- for loading -->
    <aura:attribute name="displayLoading" type="Boolean" default="false"/>
    
    
    <!-- this will be used for the Selected option -->
    <aura:attribute name="selectoptions" type="List" default="[
                                                              {'label': 'Weekly', 'value': 'WTD', 'tooltip' : 'Current Week to Date'},
                                                              {'label': 'Monthly', 'value': 'MTD',  'tooltip' : 'Current Month to Date'},
                                                              {'label': 'Quarterly', 'value': 'QTD',  'tooltip' : 'Current Quarter to Date'},
                                                              {'label': 'Annually', 'value': 'YTD',  'tooltip' : 'Current Year to Date'},
                                                              {'label': 'All', 'value': 'All',  'tooltip' : 'Current Year to Date + Prior 2 Years'}]"/>
    
    <aura:attribute name="claimAndReturnDetails" type="Object" />
    <aura:attribute name="headerName" type="String" />
    <aura:attribute name="date" type="String" />
    <aura:attribute name="parts" type="Integer" default="0"/>
    <aura:attribute name="partsValue" type="Double" default="0.0"/>
    <aura:attribute name="partsPer" type="Integer" default="0"/>
    <aura:attribute name="partsValuePer" type="Double" default="0.0"/>
    
    <aura:attribute name="selectedMenu" type="String" default="dashboardDemo"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <aura:handler name="change" value="{!v.listDealerLoc}" action="{!c.listdealerLocChange}"/>
    
    
    <div class="eo-card">
        <div class="slds-card tile" >
            <!-- spinner -->
            <aura:if isTrue="{!v.displayLoading}">
                <lightning:spinner alternativeText="Loading" size="medium" variant = "brand"/>
            </aura:if>
            
            <div class="slds-card__body slds-card__body_inner">
                <!-- Grid -->
                <div class="slds-grid gridHeight">
                    <div class="slds-col slds-size_7-of-8">
                        <!-- Tile Name -->
                        <div class="tileName_Div">
                            <div class="slds-grid slds-wrap">
                                <div class="slds-col slds-size_12-of-12 orderSumry">
                                    <span class= "heading">
                                            <a href="" 
                                               onclick="{!c.openOrdersTile}">{!v.title}
                                            </a>
                                            
                                        
                                        <!-- 13-10-21 --> 
                                        &nbsp;&nbsp;
                                        <aura:if isTrue="{!v.listDealerLoc.length==1}">
                                            <span onclick="{!c.handleOpenInNewWindow}" >                                
                                                <a href="javascript:void(0);"><img src="{!$Resource.EDealerResources + '/icons/opentabicon.svg'+'#opentabicon'}" class="imgicon-style-align"/></a>
                                            </span>
                                        </aura:if>
                                        
                                        <!-- 13-10-21 --> 
                                    </span>
                                    <span>
                                        <lightning:select value="{!v.selectedOrder}" onchange="{!c.handleSelectedOrder}" class="picklistWidth">
                                            <option value="All">{!$Label.c.All_Orders}</option>
                                            <option value="Invoiceorder">{!$Label.c.Edealer_Invoiced}</option>
                                            <option value="Activeorders">{!$Label.c.Edealer_Active}</option>
                                            <option value="Backorders">{!$Label.c.Edealer_Backordered}</option>
                                            <option value="Cancelledorders">{!$Label.c.Edealer_Cancelled}</option>
                                            
                                        </lightning:select> 
                                        <!--<lightning:formattedNumber value="{!v.activeOrders}" onclick="{!c.handleOpenInNewWindow}"/>-->
                                    </span>
                                </div>
                            </div>
                        </div>
                        <!-- INfo section-->
                        <div class="tileInfo_Div">
                            <div class="slds-grid tileInfo_Div-grid">
                                <div class="slds-col slds-size_6-of-12" style="padding-top: 1%;">
                                    <table >
                                        <tr><td><div class="tileName_Div-headername">{!$Label.c.Edealer_Order_Line_Count}</div></td></tr>
                                        <tr><td>
                                            <span class="{!v.listDealerLoc.length==1?'greenTextb':'greenTextbNP'}" style="display: grid;position: absolute;top: 40%;">
                                                <aura:if isTrue="{!v.listDealerLoc.length==1}">
                                                    <lightning:formattedNumber  value="{!v.parts}" onclick="{!c.handleOpenInNewWindow}"/>
                                                    <aura:set attribute="else">
                                                        <lightning:formattedNumber  value="{!v.parts}" />
                                                    </aura:set>
                                                </aura:if>
                                            </span>
                                            </td></tr>
                                    </table>
                                </div>
                                <div class="slds-col slds-size_6-of-12" style="padding-top: 1%;">
                                    <table style="padding-top: 1%;">
                                        <tr><td>
                                            <div class="tileName_Div-headername">{!$Label.c.Edealer_Order_Value}</div>
                                            </td></tr>
                                        <tr><td style="display:flex;">
                                            <span>
                                                <span class="supHead" >                                                    
                                                    <sup style="">$</sup>
                                                    <span class="{!v.listDealerLoc.length==1?'greenTextb':'greenTextbNP'}" style="top: 3%;">
                                                        <aura:if isTrue="{!v.selectedOrder=='Cancelledorders'}">
                                                            <lightning:formattedNumber value="0" currencyCode="USD" />
                                                            <aura:set attribute="else">
                                                                <aura:if isTrue="{!v.listDealerLoc.length==1}">
                                                                    <lightning:formattedNumber value="{!v.partsValue}" onclick="{!c.handleOpenInNewWindow}" currencyCode="USD"/>
                                                                    <aura:set attribute="else">
                                                                        <lightning:formattedNumber value="{!v.partsValue}" currencyCode="USD"/>
                                                                    </aura:set>
                                                                </aura:if>
                                                                
                                                            </aura:set>
                                                        </aura:if>                                                        
                                                    </span>
                                                </span>
                                            </span>
                                            </td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- bottom -->
                        <div class="bottom_Div">
                            <div class="slds-grid bottom_Div-grid">
                                <div class="slds-col slds-size_6-of-12 displayFlex">
                                    <span class="fontSize-x_small">
                                        <lightning:icon iconName="{!v.partsPer > 0? 'utility:arrowup': 'utility:arrowdown'}" 
                                                        alternativeText="Arrow" 
                                                        title="Arrow" 
                                                        size="x-small"
                                                        class="{!v.partsPer > 0? 'iconGreen': 'iconRed'}" />
                                        &nbsp;<span class="{!v.partsPer > 0? 'colorGreen': 'colorRed'}">{!v.partsPer}%</span>
                                    </span>
                                </div>
                                <div class="slds-col slds-size_3-of-12 displayFlex">
                                    <span class="fontSize-x_small">
                                        <aura:if isTrue="{!v.selectedOrder=='Cancelledorders'}">
                                            <lightning:icon iconName="utility:arrowdown" 
                                                            alternativeText="Arrow" 
                                                            title="Arrow" 
                                                            size="x-small"
                                                            class="iconRed" />
                                            &nbsp;<span class="colorRed">0.00%</span>
                                            <aura:set attribute="else">
                                                <lightning:icon iconName="{!v.partsValuePer > 0? 'utility:arrowup': 'utility:arrowdown'}" 
                                                                alternativeText="Arrow" 
                                                                title="Arrow" 
                                                                size="x-small"
                                                                class="{!v.partsValuePer > 0? 'iconGreen': 'iconRed'}" />
                                                &nbsp;<span class="{!v.partsValuePer > 0? 'colorGreen': 'colorRed'}">{!v.partsValuePer}%</span>
                                            </aura:set>
                                        </aura:if>
                                        
                                    </span>
                                </div>
                                <div class="slds-col slds-size_3-of-12" style="color: #797777;">
                                	{!$Label.c.Edealer_Freight_Tax_not_included}
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="slds-col slds-size_1-of-8">
                        <ul class="unOrderedList">
                            <aura:iteration items="{!v.selectoptions}" var="opt">
                                <aura:if isTrue="{!opt.label == v.selectedoption}">
                                    <li class="options selected" 
                                        name="{!opt.label}" 
                                        title="{!opt.tooltip}"
                                        onclick="{!c.updateTileDetails}">{!opt.value}</li> 
                                    
                                    <aura:set attribute="else">
                                        <li class="options" 
                                            name="{!opt.label}" 
                                            title="{!opt.tooltip}"
                                            onclick="{!c.updateTileDetails}">{!opt.value}</li>
                                    </aura:set>
                                </aura:if>
                            </aura:iteration>
                        </ul>
                        
                    </div>
                    
                </div>
            </div>
            
            <!-- information icon -->
            <div class="infoIconPosition">
                <lightning:helptext
                                    content="{!$Label.c.Edealer_Sum_of_all_the_open_orders_line_count}"
                                    />
            </div>
            
        </div>
    </div>
    
    
</aura:component>