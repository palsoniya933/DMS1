<aura:component controller="EDealerCartController" 
                implements="forceCommunity:availableForAllPageTypes" access="global" >
    
    <!-- currency code for loged in user/edealer -->
    <aura:attribute name="currencyCode" type="String" /> 
    
    <!-- LoggedIn User details -->
    <aura:attribute name="userDetail" type="Object" />
    
    <!-- Selected Delear Loc/ code -->
    <aura:attribute name="dealerCode" type="String" />
    
    <!-- this will save the items to be dispalyed -->
    <aura:attribute name="cartOrders" type="Object[]" />
    
    <aura:attribute name="PaginationList" type="Object[]" />
    
    <!-- PAgination Page Number -->
    <aura:attribute name="paginationPageNumber" type="String" />
    <!-- PAgination Page Number -->
    <aura:attribute name="paginationPageSize" type="Integer" default="25" />
    <!-- PAgination Total Pages -->
    <aura:attribute name="paginationTotalPages" type="Integer" />
    <!-- PAgination Record Start -->
    <aura:attribute name="paginationRecordStart" type="Integer" />
    <!-- PAgination Record End -->
    <aura:attribute name="paginationRecordEnd" type="Integer" />
    <!-- PAgination Record End -->
    <aura:attribute name="paginationAllPageNumber" type="Integer[]" />
    
    <!-- used t disabled previous button -->
    <aura:attribute name="paginationDisabledPrevious" type="boolean" default="true"/>
    
    <!-- used t disabled next button -->
    <aura:attribute name="paginationDisabledNext" type="boolean" default="false"/>
    
    
    <!-- used to hide / show the loading -->
    <aura:attribute name="displayLoading" type="boolean" default="false"/>
    
    <!-- used to hide / show the Modal for Cancel Order -->
    <aura:attribute name="showCancelOrderModal" type="boolean" default="false"/>
    
    <!-- used to hide / show the Modal for Place Order -->
    <aura:attribute name="showPlaceOrderModal" type="boolean" default="false"/>
    
    <!-- used to save the oredr type -->
    <aura:attribute name="ordertype" type="string" />
    <!-- full name of order type -->
    <aura:attribute name="orderName" type="string" />
    
    
    <!-- used to save the ASI Order Creation Response -->
    <aura:attribute name="asiOrderCreationRes" type="Object" />
    
    <!-- used to save the DSI Order update Response -->
    <aura:attribute name="dsiOrderUpdateRes" type="Object" />
    
    <!-- used to save the PO Number -->
    <aura:attribute name="PO_Number" type="String" />
    
    <!-- used to hide / show the Modal for Place Order -->
    <aura:attribute name="showOrderCreationDetail" type="boolean" default="false"/>
    
    <!-- this will holder the method which will be used on click of button -->
    <aura:attribute name="method" type="Aura.action"/>
    
    
    <!-- register event when cart items created -->
    <aura:registerEvent name="cartupdateevent" type="c:eDealerCartUpdateEvent"/>
    
    
    <div class="invDatacontainer">
        <table>
            <tr>
                <td></td>
                <td style="width:137px;">
                    <lightning:button class="{!v.userDetail.isNonDealer ? 'slds-m-left_xx-small secondary-btn button-Black_Disable' : (and(not(empty(v.cartOrders)), and(v.cartOrders.length > 0,v.cartOrders[0].isDBSDSI == true)) ? 'slds-m-left_xx-small button-Black' : 'slds-m-left_xx-small secondary-btn button-Black_Disable') }" 
                                      label="CANCEL ORDER" 
                                      onclick="{!c.confirmCancelOrders}" 
                                      disabled="{!or(and(v.cartOrders.length > 0,v.cartOrders[0].isDBSDSI != true), or(v.cartOrders.length == 0,v.userDetail.isNonDealer) )}"/>
                </td>
                
                <td style="width:123px;">
                    <lightning:button class="slds-m-left_xx-small"
                                      variant="destructive" 
                                      label="PLACE ORDER" 
                                      onclick="{!c.showPlaceOrderModal}"
                                      disabled="true"/>
                <!--disabled="{!or(and(v.cartOrders.length > 0,v.cartOrders[0].isDBSDSI != true), v.cartOrders.length == 0)}" -->
                </td>
            </tr>
        </table>
    </div>
    
    
    <div class="invDatacontainertablecontainer">
        
        <!-- pagination cmp -->
        <aura:if isTrue="{!v.cartOrders.length > 0}">
            <c:eDealerPagination totalRecords = "{!v.cartOrders}"
                                 totalNumberRecords = "{!v.cartOrders}"
                                 PaginationList = "{!v.PaginationList}"
                                 PageNumber="{!v.paginationPageNumber}"
                                 pageSize="{!v.paginationPageSize}"
                                 TotalPages="{!v.paginationTotalPages}"
                                 RecordStart="{!v.paginationRecordStart}"
                                 RecordEnd="{!v.paginationRecordEnd}"
                                 allPageNumber="{!v.paginationAllPageNumber}"
                                 disabledprevious="{!v.paginationDisabledPrevious}"
                                 disablednext="{!v.paginationDisabledNext}"
                                 displayPageButtons="false"></c:eDealerPagination>
        </aura:if>
        
        <table class="invDatacontainertable">
            <tr style="vertical-align: top;">                        
                <td class="invDatacontainertableheading">
                    Sr #
                </td>
                
                <td class="invDatacontainertableheading">
                    Part #
                </td>
                
                <td class="invDatacontainertableheading" >
                    Parts Description
                </td>

                <td class="invDatacontainertableheading" >
                    Source
                </td>
                
                <td class="invDatacontainertableheading">
                    Order Qty.
                </td>
                
                <td class="invDatacontainertableheading">
                    Est. Pricing ({!v.userDetail.currencyCode})
                </td>
                
                <td class="invDatacontainertableheading">
                    Order Value ({!v.userDetail.currencyCode})
                </td>
                <!-- this field only availble for dealers -->
                <aura:if isTrue="{!and(!v.userDetail.isNonDealer, and(v.cartOrders.length > 0,v.cartOrders[0].isDBSDSI == true) )}">
                <td class="invDatacontainertableheading">
                    Remove
                </td>
                </aura:if>
            </tr>
            <aura:if isTrue="{!v.PaginationList.length > 0}">
                <!-- this is the iteration for rows -->
                <aura:iteration items="{!v.PaginationList}" var="inv" indexVar="index">
                    
                    <tr>                            
                        <td class="invDatacontainertabledata">
                            {!add(index,1)}
                        </td>
                        
                        <td class="invDatacontainertabledata">
                            {!inv.Part_Name}
                        </td>
                        
                        <td class="invDatacontainertabledata" >
                            {!inv.Part_Description}
                        </td>
                        
                        <td class="invDatacontainertabledata" >
                             {!(inv.isPromo == true) ? 'Promo '+inv.source : inv.source}
                        </td>
                        
                        <td class="invDatacontainertabledata" >                           
                            <lightning:input type="number" 
                                             value="{!inv.qtyForOrder}"
                                             variant="label-hidden" 
                                             class="label-hidden"
                                             onblur="{!c.getupdatedQntRec}" 
                                             name="{!inv.cartId}"
                                             aura:id ="myRecId"
                                             disabled="{!or(and(v.cartOrders.length > 0,v.cartOrders[0].isDBSDSI != true), or(v.cartOrders.length == 0,v.userDetail.isNonDealer) )}"/>
                        </td>
                        
                        <td class="invDatacontainertabledata">
                            <!--Est. Pricing-->
                            <aura:if isTrue="{!or(and(inv.cartOrderType == 'DSP', or(empty(inv.PriceDetail.DspFinalNet),inv.PriceDetail.DspFinalNet == 0) ), and(inv.cartOrderType == 'PDC', or(empty(inv.PriceDetail.WhsFinalNet), inv.PriceDetail.WhsFinalNet == 0)) )}">
                                <div class="cTooltip" style="position:relative">
                                    <lightning:icon class="nonpacar"
                                                    iconName="utility:warning" 
                                                    alternativeText="warning" 
                                                    size="small" />
                                    <div class="tooltiptext slds-popover slds-popover_tooltip slds-nubbin_bottom-right" role="tooltip" id="help" style="position: absolute;top: -100px;left: 5px;">
                                        <div class="slds-popover__body">Part pricing not available</div>
                                    </div>
                                </div>
                                <aura:set attribute="else">
                                    <lightning:input type="number" readonly="true" variant="label-hidden" value="{!(inv.cartOrderType == 'DSP' ? inv.PriceDetail.DspFinalNet : (inv.cartOrderType == 'PDC' ? inv.PriceDetail.WhsFinalNet : ''))}" step="0.01" />
                                </aura:set>
                            </aura:if>
                        </td>
                        
                        <td class="invDatacontainertabledata">
                            <!--Order Value-->
                            <aura:if isTrue="{!or(and(inv.cartOrderType == 'DSP', or(empty(inv.PriceDetail.DspFinalNet),inv.PriceDetail.DspFinalNet == 0) ), and(inv.cartOrderType == 'PDC', or(empty(inv.PriceDetail.WhsFinalNet), inv.PriceDetail.WhsFinalNet == 0)) )}">
                               <aura:set attribute="else">
                                   <lightning:input type="number" readonly="true" variant="label-hidden" value="{!(inv.cartOrderType == 'DSP' ? mult(inv.PriceDetail.DspFinalNet,inv.qtyForOrder)  : (inv.cartOrderType == 'PDC' ? mult(inv.PriceDetail.WhsFinalNet,inv.qtyForOrder) : '') ) }" step="0.01" />
                                    
                                </aura:set>
                            </aura:if>
                        </td>
                        
                        <aura:if isTrue="{!and(!v.userDetail.isNonDealer, inv.isDBSDSI == true)}">
                        <td class="invDatacontainertabledata">
                            <div name="{!inv.cartId}" onclick="{!c.deleteItem}">
                                <lightning:icon size="xx-small" iconName="action:close"  />
                            </div>
                        </td>                           
                        </aura:if>
                    </tr>
                    
                </aura:iteration>
            </aura:if>
        </table>
        
        <aura:if isTrue="{!or(v.PaginationList == undefined, and(v.PaginationList != undefined, v.PaginationList.length == 0)) }">
        <c:eDealerNotRecordFound 
                                             Message="{!'You don\'t have any part(s) added in ' + v.orderName + ' cart'}"
                                             iconName="utility:info"
                                             cssClassname="blackicon"
                                             warningBoxClassName="warningboxYellow"
                                             />
        </aura:if>
        <!-- pagination cmp -->
        <aura:if isTrue="{!v.cartOrders.length > 0}">
            <c:eDealerPagination totalRecords = "{!v.cartOrders}"
                                 totalNumberRecords = "{!v.cartOrders}"
                                 PaginationList = "{!v.PaginationList}"
                                 PageNumber="{!v.paginationPageNumber}"
                                 pageSize="{!v.paginationPageSize}"
                                 TotalPages="{!v.paginationTotalPages}"
                                 RecordStart="{!v.paginationRecordStart}"
                                 RecordEnd="{!v.paginationRecordEnd}"
                                 allPageNumber="{!v.paginationAllPageNumber}"
                                 disabledprevious="{!v.paginationDisabledPrevious}"
                                 disablednext="{!v.paginationDisabledNext}"
                                 displayPageButtons="true"></c:eDealerPagination>
        </aura:if>
        
    </div>
    
    <!-- order modal -->
    <aura:if isTrue="{!v.showCancelOrderModal}">
        <section role="dialog" tabindex="-1" aria-label="Meaningful description of the modal content" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
            <div class="slds-modal__container">
                <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                    <div class="emergencyorderMessage" align="center" style="font-size: initial;">
                        <p><strong> Do you want to cancel all cart items ?</strong>
                        </p>
                    </div>                    
                </div>
                <footer class="slds-modal__footer slds-modal__footer_directional">
                    <lightning:button variant="destructive" label="NO" onclick="{!c.closeCartConfirmationModal}" />
                    <lightning:button variant="destructive" label="YES" onclick="{!c.deleteAllItems}" />
                </footer>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
    
   
    <!-- Order Creation Details modal -->
    <aura:if isTrue="{!v.showOrderCreationDetail}">
    <section role="dialog" tabindex="-1" aria-label="Meaningful description of the modal content" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open slds-modal_large">
        <div class="slds-modal__container">               
            <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1" style="position: relative;">              
                <div class="paddingCls">
                    <div class="slds-col slds-medium-size_12-of-12 lFloat popheading">
                        ORDER Creation Details
                        <lightning:icon class="iconcolr slds-float--right" size="small" iconName="utility:close" variant="bare" alternativeText="close" title="close" onclick="{! c.closeOrderDetailModal }" />
                    </div>
                    
                    <aura:if isTrue="{!or(empty(v.asiOrderCreationRes.Data.OrderNumber),v.asiOrderCreationRes.MsgResponse.Messages.length > 0)}">
                    <div class="slds-col slds-medium-size_12-of-12">
                        <div class="slds-notify slds-notify_alert customWarning" role="alert">
                            <lightning:icon class="customWarningIcon" iconName="utility:warning" size="small" alternativeText="Warning!" />
                            <h2>Order has some errors, please check with customer service for more details or check order exception report in DRC
                            </h2>
                        </div>
                    </div>
                    </aura:if>
                    
                    <div class="slds-col slds-medium-size_12-of-12">
                        <aura:if isTrue="{!and(v.asiOrderCreationRes.Data != undefined, not(empty(v.asiOrderCreationRes.Data.OrderNumber)))}">
                        	<p>Your Order has been created with Order Number : <strong>{!v.asiOrderCreationRes.Data.OrderNumber}</strong></p>
                        	<aura:set attribute="else">
                                <p>Your Order has not created</p>
                        	</aura:set>
                        </aura:if>
                        <p>PO Number : <strong>{!v.PO_Number}</strong></p>
                        
                    </div>
                    
                    <div class="slds-col slds-medium-size_12-of-12">
                        <br/>
                        <div style="font-size:15px;"><strong>Ordered Parts</strong></div>
                        
                        <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_col-bordered">
                            <thead>
                                <tr class="slds-line-height_reset">
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Part Number">Part Number</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Customer SKU">Customer SKU</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Quantity">Quantity</div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
    
                            <aura:if isTrue="{!and(v.asiOrderCreationRes.Data != undefined, v.asiOrderCreationRes.Data != null)}">
                                <aura:iteration items="{!v.asiOrderCreationRes.Data.OrderPartDetails}" var="item" indexVar="index">
                                    <tr class="slds-hint-parent">
                                        <td>
                                            <div class="slds-truncate">{!item.ItemID}</div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">{!item.CustomerSKU}</div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">{!item.PartQuantity}</div>
                                        </td>
                                    </tr>
                                </aura:iteration>
                                </aura:if>
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="slds-col slds-medium-size_12-of-12 slds-scrollable">
                        <br/>
                        <div style="font-size:15px;"><strong>Warnings/Errors</strong></div>
                        <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_col-bordered">
                            <thead>
                                <tr class="slds-line-height_reset">
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Type">Type</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="part Number">part Number</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Description">Description</div>
                                    </th>
                            </tr>
                            </thead>
                            <tbody>
                            <aura:if isTrue="{!and(v.asiOrderCreationRes.MsgResponse != undefined, v.asiOrderCreationRes.MsgResponse != null)}">
                                <aura:iteration items="{!v.asiOrderCreationRes.MsgResponse.Messages}" var="item" indexVar="index">
                                    <tr class="slds-hint-parent">
                                        <td>
                                            <div class="slds-truncate">{!item.MsgIdentifier}</div>
                                        </td>
                                         <td>
                                            <div class="slds-truncate">{!item.MsgItmid}</div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">{!item.Description}</div>
                                        </td>
                                    </tr>
                                </aura:iteration>
                            </aura:if>
                            </tbody>
                        </table>
                    </div> 
                    
                    <aura:if isTrue="{!v.dsiOrderUpdateRes != undefined}">
						
                        <div class="slds-col slds-medium-size_12-of-12 slds-scrollable">
                            <br/>
                            <div style="font-size:15px;"><strong>DSI Accepted Parts</strong></div>
                            <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_col-bordered">
                                <thead>
                                    <tr class="slds-line-height_reset">
                                        <th class="" scope="col">
                                            <div class="slds-truncate" title="part Number">part Number</div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <aura:if isTrue="{!v.dsiOrderUpdateRes.OrderUpdateStatus.acceptedPartsNumbers != undefined}">
                                    <aura:iteration items="{!v.dsiOrderUpdateRes.OrderUpdateStatus.acceptedPartsNumbers}" var="part" indexVar="index">
                                            <tr class="slds-hint-parent">
                                                <td>
                                                    <div class="slds-truncate">{!part}</div>
                                                </td>
                                            </tr>
                                        </aura:iteration>
                                    </aura:if>
                                </tbody>
                            </table>
                        </div>
                        <br/>
                        <div class="slds-col slds-medium-size_12-of-12 slds-scrollable">
                            <br/>
                            <div style="font-size:15px;"><strong>DSI non-Accepted Parts</strong></div>
                            <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_col-bordered">
                                <thead>
                                    <tr class="slds-line-height_reset">
                                        <th class="" scope="col">
                                            <div class="slds-truncate" title="part Number">part Number</div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <aura:if isTrue="{!v.dsiOrderUpdateRes.OrderUpdateStatus.nonacceptedPartsNumbers != undefined}">
                                        <aura:iteration items="{!v.dsiOrderUpdateRes.OrderUpdateStatus.nonacceptedPartsNumbers}" var="part" indexVar="index">
                                            <tr class="slds-hint-parent">
                                                <td>
                                                    <div class="slds-truncate">{!part}</div>
                                                </td>
                                            </tr>
                                        </aura:iteration>
                                    </aura:if>
                                </tbody>
                            </table>
                        </div>
                    </aura:if>
                    
                </div>
            </div>                
        </div>
    </section>
    <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
    
    
    
    <!-- this is for place order modal -->
    <aura:if isTrue="{!v.showPlaceOrderModal}">
        <c:eDealerPlaceOrder showPlaceOrderModal="{!v.showPlaceOrderModal}"
                                     cartOrders = "{!v.cartOrders}" 
                                     orderType = "{!v.ordertype}"
                                     dealerCode = "{!v.dealerCode}"
                                     cancel= "{!c.closePlaceOrderModal}"
                                     refresh="{!c.refreshCart}"
                             		userDetail="{!v.userDetail}"
                             		isShowModal="{!v.showOrderCreationDetail}"
                             		asiOrderCreationRes="{!v.asiOrderCreationRes}"
                             		dsiOrderUpdateRes="{!v.dsiOrderUpdateRes}"
                             		po="{!v.PO_Number}"/>
    </aura:if>
    
</aura:component>