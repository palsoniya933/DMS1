<aura:component implements="forceCommunity:availableForAllPageTypes" access="global" >
    
    <aura:attribute name="totalInventroyLines" type="Integer" default="0"/>
    <aura:attribute name="lastRefreshDate" type="Date" />    
    <aura:attribute name="partsDetailList" type="Object[]" /> 
    <aura:attribute name="totalOrderSelected" type="Integer" default="0" />
    
        
    <div>
    <div class="">
            <div class="sugOrderSubHead">
              <ul>
                  <li>
                      <div class="heading">{!$Label.c.Total_Inventory_Lines}</div>
                      <div class="amtTxt">{!v.totalInventroyLines}</div>
                  </li> 
                  <li>
                     <div class="heading">{!$Label.c.LAST_REFRESH_DATE_PST}</div>
                     <div class="amtTxt">
                         <ui:outputDateTime  class="datetxt" value="{!v.lastRefreshDate}" />
                      &nbsp;
                         <!--<lightning:icon iconName="utility:refresh" size="xx-small" alternativeText="refresh" title="refresh" />-->
                      </div>
                      
                      
                  </li> 
                  <li>
                   
                  </li>
              </ul>
            </div>
    </div>
    </div>
</aura:component>