<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Tax_Type_Required_for_New_ISP</fullName>
    <active>false</active>
    <description>Requires the Tax Type to be entered when creating a new account with ISP record type.</description>
    <errorConditionFormula>AND( 
     RecordType.DeveloperName  = &quot;Independent_Service_Provider&quot;,
ISNEW(),
OR(
    ISBLANK(TEXT(Tax_Type__c))
)
)</errorConditionFormula>
    <errorDisplayField>Tax_Type__c</errorDisplayField>
    <errorMessage>Tax Type is required.</errorMessage>
</ValidationRule>
