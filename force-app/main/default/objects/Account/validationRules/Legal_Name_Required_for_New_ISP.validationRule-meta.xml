<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Legal_Name_Required_for_New_ISP</fullName>
    <active>true</active>
    <description>Requires the legal name to be entered when creating a new ISP account.</description>
    <errorConditionFormula>AND( 
     RecordType.DeveloperName  = &quot;Independent_Service_Provider&quot;,
ISNEW(),
OR(
    ISBLANK(Legal_Name__c)
)
)</errorConditionFormula>
    <errorDisplayField>Legal_Name__c</errorDisplayField>
    <errorMessage>Legal Name is required</errorMessage>
</ValidationRule>
